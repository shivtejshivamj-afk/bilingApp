import "jsr:@supabase/functions-js/edge-runtime.d.ts";
import { createClient } from "jsr:@supabase/supabase-js@2";
import webpush from "npm:web-push";

interface WebhookPayload {
  type: string;
  table: string;
  schema: string;
  record: {
    id: string;
    restaurant_id: string;
    table_number: number;
    items: unknown[];
  };
}

const supabaseUrl = Deno.env.get('SUPABASE_URL')!;
const serviceRoleKey = Deno.env.get('SUPABASE_SERVICE_ROLE_KEY')!;
const vapidPublicKey = Deno.env.get('VAPID_PUBLIC_KEY')!;
const vapidPrivateKey = Deno.env.get('VAPID_PRIVATE_KEY')!;
const webhookSecret = Deno.env.get('PUSH_WEBHOOK_SECRET')!;

webpush.setVapidDetails('mailto:notifications@scannbite.com', vapidPublicKey, vapidPrivateKey);

Deno.serve(async (req) => {
  if (req.method !== 'POST') return new Response('Method not allowed', { status: 405 });

  const suppliedSecret = req.headers.get('x-scannbite-webhook-secret');
  if (!webhookSecret || suppliedSecret !== webhookSecret) {
    return new Response('Unauthorized', { status: 401 });
  }

  let payload: WebhookPayload;
  try {
    payload = await req.json();
  } catch {
    return new Response('Invalid JSON', { status: 400 });
  }

  if (payload.type !== 'INSERT' || payload.table !== 'orders' || payload.schema !== 'public' || !payload.record?.restaurant_id) {
    return Response.json({ ok: true, skipped: true });
  }

  const admin = createClient(supabaseUrl, serviceRoleKey, {
    auth: { autoRefreshToken: false, persistSession: false },
  });

  const { data: subscriptions, error } = await admin
    .from('push_subscriptions')
    .select('id, endpoint, p256dh, auth')
    .eq('restaurant_id', payload.record.restaurant_id);

  if (error) return Response.json({ ok: false, error: error.message }, { status: 500 });

  const itemCount = Array.isArray(payload.record.items) ? payload.record.items.length : 0;
  const tableNumber = payload.record.table_number;
  const body = `${itemCount} item${itemCount === 1 ? '' : 's'} just placed at Table ${tableNumber}.`;
  const url = `/admin`;

  const results = await Promise.all((subscriptions ?? []).map(async (row) => {
    try {
      await webpush.sendNotification(
        { endpoint: row.endpoint, keys: { p256dh: row.p256dh, auth: row.auth } },
        JSON.stringify({
          title: `New Order — Table ${tableNumber}`,
          body,
          tag: `scannbite-order-${payload.record.id}`,
          url,
        }),
        { TTL: 300, urgency: 'high' },
      );
      return { ok: true };
    } catch (err: any) {
      const status = err?.statusCode;
      if (status === 404 || status === 410) {
        await admin.from('push_subscriptions').delete().eq('id', row.id);
      }
      return { ok: false, status };
    }
  }));

  return Response.json({ ok: true, sent: results.filter((r) => r.ok).length, total: results.length });
});
